function calculate(){let t=tierFor(+state.allocation||0),pax=Math.max(30,+state.pax||30),cost=categories.reduce((s,x,i)=>s+x[1]*state.qty[i],0),rev=pax*state.selling,tc=pax*cost,profit=rev-tc,pct=rev?profit/rev:0,totalQty=state.qty.reduce((a,b)=>a+b,0),actual=state.menus.reduce((a,m)=>a+selectedCount(m),0),hasOver=state.qty.some((q,i)=>selectedCount(state.menus[i])>q),isComplete=!!t&&!hasOver&&state.qty.every((q,i)=>q===selectedCount(state.menus[i]));$('tier').textContent=t?t.code:'DI LUAR RANGE';$('quota').textContent=t?t.quota:'—';$('costPax').textContent=rp(cost);$('revenue').textContent=rp(rev);$('totalCost').textContent=rp(tc);$('profit').textContent=rp(profit);$('profitPax').textContent=rp(state.selling-cost);$('profitPct').textContent=(pct*100).toFixed(1)+'%';$('marginStatus').textContent=pct>=.7?'TINGGI':pct>=.5?'MODERATE':'RENDAH';$('totalQty').textContent=totalQty;$('totalCostPax').textContent=rp(cost);$('quotaMessage').textContent=t?`Pilihan menu: ${actual} dari kuota ${totalQty}`:'Masukkan alokasi di range Rp135.000–Rp299.000';let top=$('completion'),bottom=$('finalStatus');top.className='status';bottom.className='final-status';if(hasOver){top.textContent='Melebihi kuota';top.classList.add('exceeded');bottom.textContent='MELEBIHI KUOTA';bottom.classList.add('exceeded')}else if(isComplete){top.textContent='SELESAI';top.classList.add('complete');bottom.textContent='SELESAI';bottom.classList.add('complete')}else{top.textContent='Lengkapi Menu';bottom.textContent='LENGKAPI MENU'}$('tierHelp').textContent=t?`${t.code}: ${rp(t.min)}–${rp(t.max)} → harga jual ${rp(t.price)}`:'Tidak ada tier untuk nilai tersebut.'}
function applyRange(){let t=tierFor(+state.allocation||0);if(t){state.selling=t.price;state.qty=t.qty.slice();state.menus=state.menus.map((m,i)=>state.qty[i]?m:['','',''])}else{state.selling=0;state.qty=categories.map(()=>0);state.menus=categories.map(()=>['','',''])}$('selling').value=state.selling;render();calculate()}function syncInputs(){$('allocation').value=state.allocation;$('pax').value=state.pax;$('selling').value=state.selling}function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}function save(){localStorage.setItem('banquetStatusQuotaApp',JSON.stringify(state));toast('Simulasi berhasil disimpan di browser.')}function load(){try{let s=JSON.parse(localStorage.getItem('banquetStatusQuotaApp'));if(!s){toast('Belum ada simulasi tersimpan.');return}state={...newState(),...s};syncInputs();applyRange();toast('Simulasi tersimpan berhasil dimuat.')}catch(e){toast('Simpanan tidak dapat dibaca.')}}function fresh(){if(confirm('Buat simulasi baru? Data yang belum disimpan akan hilang.')){state=newState();syncInputs();render();calculate();toast('Simulasi baru dibuat.')}}$('allocation').oninput=e=>{state.allocation=+e.target.value||0;applyRange()};$('pax').oninput=e=>{state.pax=Math.max(30,+e.target.value||30);e.target.value=state.pax;calculate()};$('saveBtn').onclick=save;$('saveTopBtn').onclick=save;$('loadBtn').onclick=load;$('loadBottomBtn').onclick=load;$('newBtn').onclick=fresh;$('resetBtn').onclick=fresh;$('printBtn').onclick=()=>window.print();$('printTopBtn').onclick=()=>window.print();$('helpBtn').onclick=()=>$('modal').classList.add('open');$('closeHelpBtn').onclick=()=>$('modal').classList.remove('open');$('modal').onclick=e=>{if(e.target===$('modal'))$('modal').classList.remove('open')};syncInputs();render();calculate();
</script></body></html>
