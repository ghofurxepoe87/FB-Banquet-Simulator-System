const $=id=>document.getElementById(id),rp=v=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(v||0),newState=()=>({allocation:235000,pax:30,selling:250000,qty:tiers[2].qty.slice(),menus:categories.map(()=>['','',''])});let state=newState();function tierFor(v){return tiers.find(t=>v>=t.min&&v<=t.max)||null}function menuOptions(cat,value){return '<option value="">— Pilih menu —</option>'+options[cat].map(x=>`<option value="${x.replaceAll('"','&quot;')}" ${x===value?'selected':''}>${x}</option>`).join('')}function selectedCount(m){return m.filter(Boolean).length}function catState(i){let target=state.qty[i],actual=selectedCount(state.menus[i]);if(target===0)return {text:'Sesuai',cls:'ok'};if(actual>target)return {text:'Melebihi kuota',cls:'over'};if(actual<target)return {text:'Lengkapi Menu',cls:'wait'};return {text:'Sesuai',cls:'ok'}}
